{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "webview-project",
  "version": "0.1.0",
  "identifier": "com.webview-project.app",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
    "app": {
    "windows": [
      {
        "title": "webview-project",
        "maximized": true,
        "resizable": false
       }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
